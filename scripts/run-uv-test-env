#!/usr/bin/env scripts/uv-run-script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#     "uv==0.12.5",
# ]
# ///
from __future__ import annotations

import argparse
from importlib.metadata import version
import json
import os
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from scripts import test_environments  # noqa: E402


def find_instances(identifier: str, python: str | None = None):
    return [
        instance
        for instance in test_environments.find(identifier)
        if instance.command and (python is None or instance.python == python)
    ]


def base_venv(python_hint: str) -> Path:
    return ROOT / ".test-env" / "uv-bases" / f"py{python_hint}"


def write_metadata(identifier: str, instances, base: Path) -> Path:
    first = instances[0]
    uv = Path(sys.executable).with_name("uv")
    if not uv.is_file():
        raise RuntimeError(f"Pinned uv executable was not installed at {uv}")
    metadata = {
        "base_digest": (base / ".dd-uv-base").read_text().strip(),
        "hash": first.id,
        "python": first.python,
        "requirements": f"tests/environments/locks/{first.id}.txt",
        "uv": str(uv),
        "uv_version": version("uv"),
        "instances": [
            {
                "command": instance.command,
                "env": dict(instance.variables),
                "full_packages": " ".join(instance.requirements),
                "hash": instance.id,
                "ident": instance.identity,
                "name": instance.name,
                "packages": " ".join(instance.requirements),
                "python": instance.python,
            }
            for instance in instances
        ],
    }
    metadata_dir = ROOT / ".cache" / "uv-test-metadata"
    metadata_dir.mkdir(parents=True, exist_ok=True)
    metadata_path = metadata_dir / f"{identifier}.json"
    metadata_path.write_text(json.dumps(metadata, indent=2, sort_keys=True))
    return metadata_path


def main() -> int:
    separator = sys.argv.index("--") if "--" in sys.argv else len(sys.argv)
    parser = argparse.ArgumentParser()
    parser.add_argument("--python")
    parser.add_argument("identifier")
    args = parser.parse_args(sys.argv[1:separator])
    command_args = sys.argv[separator + 1 :] if separator < len(sys.argv) else []

    identifier = args.identifier
    instances = find_instances(identifier, args.python)
    if not instances:
        print(f"No test environment found for {identifier}", file=sys.stderr)
        return 2

    python_hints = {instance.python for instance in instances}
    hashes = {instance.id for instance in instances}
    if len(python_hints) != 1 or len(hashes) != 1:
        print(f"Environment {identifier} is ambiguous; use its exact hash", file=sys.stderr)
        return 2

    python_hint = instances[0].python
    base = base_venv(python_hint)
    if not (base / "bin" / "python").is_file():
        result = subprocess.run(
            [str(ROOT / "scripts" / "build-uv-base"), python_hint],
            cwd=ROOT,
        )
        if result.returncode:
            return result.returncode
        if not (base / "bin" / "python").is_file():
            print(f"Base environment was not created for Python {python_hint}", file=sys.stderr)
            return 2

    requirements = test_environments.LOCK_ROOT / f"{instances[0].id}.txt"
    if not requirements.is_file():
        print(f"Missing requirements lock: {requirements}", file=sys.stderr)
        return 2

    metadata_path = write_metadata(identifier, instances, base)
    metadata = json.loads(metadata_path.read_text())
    command = [
        metadata["uv"],
        "run",
        "--no-project",
        "--python",
        str(base / "bin" / "python"),
        "--",
        "python",
        "scripts/uv_test_env.py",
        str(metadata_path),
        "--",
        *command_args,
    ]
    return subprocess.run(command, cwd=ROOT, env=os.environ.copy()).returncode


if __name__ == "__main__":
    raise SystemExit(main())
